# Copy to .env and adjust. Every variable is documented in docs/configuration.md.
# VITE_* values are compiled into the browser bundle: never put secrets here.
#
# The dev container (`.devcontainer/`) and `docker-compose.dev.yml` do not read
# this file: they write `public/runtime-config.js` from the environment instead,
# so the same image works against any local stack. See docs/dev-container.md.

# --- Required (unless VITE_DEMO_MODE=true) ---------------------------------
# Indexer-Backend base URL (docker compose in Indexer-Backend serves it on 3000).
VITE_API_URL=http://localhost:3000
# Folder Soroban contract on testnet (Indexer-Contract deployments/testnet.json).
VITE_FOLDER_CONTRACT_ID=CDDQK74SMH4RB4HYLHM6BYZPTAMDMRISHW5Q274KADVZVFD57K43O6KV

# --- Optional ---------------------------------------------------------------
# Only "testnet" is supported.
VITE_STELLAR_NETWORK=testnet
# Soroban RPC used to simulate, submit and poll transactions.
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Optional ordered, comma-separated list of Soroban RPC endpoints. Reads and
# getTransaction polling fail over across them; writes are submitted to exactly
# one provider. The single URL above is kept as a last-resort fallback.
# VITE_SOROBAN_RPC_URLS=https://soroban-testnet.stellar.org,https://rpc.ankr.com/stellar_soroban
# Gateway used to read portfolio and template JSON. With the backend's docker
# compose stack you can use the local Kubo gateway: http://localhost:8080/ipfs
VITE_IPFS_GATEWAY_URL=https://ipfs.io/ipfs
# "true" serves bundled fixture data with a visible "Demo data" banner and
# disables on-chain writes. No backend or contract needed.
VITE_DEMO_MODE=false
# Sentry-compatible DSN for opt-in error reporting. Empty (default) disables it:
# the SDK is lazy-loaded only when this is set, so it costs nothing in the bundle.
# Events are scrubbed of Stellar addresses, folder names, CIDs and XDR before send.
VITE_ERROR_REPORTING_DSN=

# --- Local stack (docker-compose.dev.yml / dev container) -------------------
# Values used by the one-shot contract deploy container and the frontend
# container. They are not read by Vite directly; the entrypoint turns them into
# public/runtime-config.js. See docs/dev-container.md.
# Stellar Quickstart network passphrase (local standalone network).
STELLAR_NETWORK_PASSPHRASE=Standalone Network ; February 2017
# Soroban RPC exposed by the quickstart container.
SOROBAN_RPC_URL=http://stellar:8000/soroban/rpc
# Contract ID written by the deploy container to the shared volume.
FOLDER_CONTRACT_ID_FILE=/shared/folder-contract-id
# Indexer-Backend base URL as seen from the browser.
API_URL=http://localhost:3000
# Kubo gateway as seen from the browser.
IPFS_GATEWAY_URL=http://localhost:8080/ipfs

# --- Dev container only -----------------------------------------------------
# Git ref of Indexer-Contract to build and deploy (default: main).
CONTRACT_REF=main
# Git ref of Indexer-Backend to build (default: main).
BACKEND_REF=main
