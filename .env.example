# Copy to .env and adjust. Every variable is documented in docs/configuration.md.
# VITE_* values are compiled into the browser bundle: never put secrets here.

# --- Required (unless VITE_DEMO_MODE=true) ---------------------------------
# Indexer-Backend base URL (docker compose in Indexer-Backend serves it on 3000).
VITE_API_URL=http://localhost:3000
# Folder Soroban contract on testnet (Indexer-Contract deployments/testnet.json).
VITE_FOLDER_CONTRACT_ID=CDDQK74SMH4RB4HYLHM6BYZPTAMDMRISHW5Q274KADVZVFD57K43O6KV

# --- Optional ---------------------------------------------------------------
# Only "testnet" is supported.
VITE_STELLAR_NETWORK=testnet
# Soroban RPC used to simulate, submit and poll transactions.
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Gateway used to read portfolio and template JSON. With the backend's docker
# compose stack you can use the local Kubo gateway: http://localhost:8080/ipfs
VITE_IPFS_GATEWAY_URL=https://ipfs.io/ipfs
# "true" serves bundled fixture data with a visible "Demo data" banner and
# disables on-chain writes. No backend or contract needed.
VITE_DEMO_MODE=false
